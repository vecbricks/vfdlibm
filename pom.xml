<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.vecbricks</groupId>
  <artifactId>vfdlibm</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>vfdlibm</name>
  <description>fdlibm on the Java Vector API, bit-identical to java.lang.StrictMath</description>
  <url>https://github.com/vecbricks/vfdlibm</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>MaxGekk</id>
      <name>Max Gekk</name>
      <organization>vecbricks</organization>
      <organizationUrl>https://github.com/vecbricks</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/vecbricks/vfdlibm.git</connection>
    <developerConnection>scm:git:git@github.com:vecbricks/vfdlibm.git</developerConnection>
    <url>https://github.com/vecbricks/vfdlibm</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- Java 25 and the incubating Vector API (jdk.incubator.vector), which every function's
         lanes are written in; the module is added at compile time, in tests and in benchmarks. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <jmh.version>1.37</jmh.version>
    <maven.surefire.version>3.2.5</maven.surefire.version>
    <vector.module>jdk.incubator.vector</vector.module>
    <!-- Extra JVM options for the test JVM, empty by default. -Dvfdlibm.test.jvmArgs=
         -XX:MaxVectorSize=32 makes an AVX-512 host behave like an AVX2 one (no 512-bit species),
         which shows the skip path an AVX2 runner takes; =16 runs every case at 128 bits. -->
    <vfdlibm.test.jvmArgs></vfdlibm.test.jvmArgs>
    <!-- The phase the fault runs are bound to; the profile one-test sets it to none. -->
    <vfdlibm.fault.phase>test</vfdlibm.fault.phase>
    <!-- The test JVM's options, shared by the normal run and every fault run. -->
    <vfdlibm.test.argLine>
      --add-modules ${vector.module} ${vfdlibm.test.jvmArgs}
    </vfdlibm.test.argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>${vector.module}</arg>
            <!-- No -Werror: javac's warning that an incubating module is in use cannot be
                 suppressed, and would fail every build. -->
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <!-- JMH's annotation processor writes the benchmark list and harness classes. JDK 23
               and later run no processor unless one is configured, so it is named here. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.openjdk.jmh</groupId>
                  <artifactId>jmh-generator-annprocess</artifactId>
                  <version>${jmh.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Benchmarks live in src/jmh/java and compile with the tests, so `verify` keeps them
             building; the jmh profile runs them. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-jmh-source</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>src/jmh/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.version}</version>
        <configuration>
          <argLine>${vfdlibm.test.argLine}</argLine>
          <excludes>
            <!-- JMH's generated *_jmhTest classes are benchmarks, not tests. -->
            <exclude>**/jmh_generated/**</exclude>
            <!-- Surefire's own default, which a list of excludes replaces. -->
            <exclude>**/*$*</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- The normal suite, with no fault planted. -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>fault</excludedGroups>
            </configuration>
          </execution>
          <!-- The fault runs (PLAN.md section 4): one forked JVM per planted fault, with
               -Dvfdlibm.fault=<name> set before Faults loads, running only the tests tagged
               `fault`, which require the fault's checks to fail. A fault is listed in
               PlantedFaultTest.CATCHERS and gets an execution here; PlantedFaultTest checks that
               both hold. A fault run that runs no test fails (failIfNoTests), so a mistyped
               group or a lost tag cannot drop the fault's check silently. With -Dtest=..., the
               profile one-test unbinds the fault runs, which that filter would leave empty. -->
          <execution>
            <id>fault-selftest.oneUlp</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=selftest.oneUlp</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-selftest.nanPayload</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=selftest.nanPayload</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-selftest.zeroSign</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=selftest.zeroSign</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-exp.dropCorrection</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=exp.dropCorrection</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-exp.constantOffByOneUlp</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=exp.constantOffByOneUlp</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-exp.thresholdMoved</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=exp.thresholdMoved</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log.dropCorrection</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log.dropCorrection</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log.constantOffByOneUlp</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log.constantOffByOneUlp</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log.thresholdMoved</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log.thresholdMoved</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log10.dropCorrection</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log10.dropCorrection</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log10.constantOffByOneUlp</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log10.constantOffByOneUlp</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log10.thresholdMoved</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log10.thresholdMoved</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log1p.dropCorrection</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log1p.dropCorrection</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log1p.constantOffByOneUlp</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log1p.constantOffByOneUlp</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log1p.thresholdMoved</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log1p.thresholdMoved</argLine>
            </configuration>
          </execution>
          <execution>
            <id>fault-log1p.guardMissesNonFinite</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=log1p.guardMissesNonFinite</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.vecbricks.vfdlibm</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- One test: `mvn test -Dtest=ExpTest` runs only the normal suite's filtered tests. The fault
         runs are skipped, since a -Dtest filter leaves them no test and they fail on that. -->
    <profile>
      <id>one-test</id>
      <activation>
        <property><name>test</name></property>
      </activation>
      <properties>
        <vfdlibm.fault.phase>none</vfdlibm.fault.phase>
      </properties>
    </profile>
    <!-- Benchmarks: `mvn -B -Pjmh test-compile exec:exec` runs every JMH benchmark, and
         -Djmh.args="..." passes JMH's own options (a name regex, -p, -f, -wi, -i). -->
    <profile>
      <id>jmh</id>
      <properties>
        <jmh.args></jmh.args>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.1</version>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <commandlineArgs>
                --add-modules ${vector.module} -classpath %classpath
                org.openjdk.jmh.Main ${jmh.args}
              </commandlineArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Publishing: sources and javadoc jars, signatures, and the Central portal. Releases are
         cut from tags; Varka pins a released version and never a snapshot. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.10.1</version>
            <configuration>
              <additionalOptions>
                <additionalOption>--add-modules</additionalOption>
                <additionalOption>${vector.module}</additionalOption>
              </additionalOptions>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
