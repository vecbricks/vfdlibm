  <properties>
    <!-- Java 25 and the incubating Vector API (jdk.incubator.vector), which every function's
         lanes are written in; the module is added at compile time, in tests and in benchmarks. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Makes the jars reproducible: the plugins that pack them stamp their entries with this
         time and not the build's own. dev/release.sh sets it to the release's time in the
         release commit; between releases it is the last one's, or this placeholder, so the
         entries of a snapshot jar all carry that fixed date on purpose. -->
    <project.build.outputTimestamp>2026-11-20T22:37:56Z</project.build.outputTimestamp>
    <junit.version>6.1.3</junit.version>
    <jmh.version>1.37</jmh.version>
    <maven.surefire.version>3.6.1</maven.surefire.version>
    <vector.module>jdk.incubator.vector</vector.module>
    <!-- Extra JVM options for the test JVM, empty by default. -Dvfdlibm.test.jvmArgs=
         -XX:MaxVectorSize=32 makes an AVX-512 host behave like an AVX2 one (no 512-bit species),
         which shows the skip path an AVX2 runner takes; =16 runs every case at 128 bits. -->
    <vfdlibm.test.jvmArgs></vfdlibm.test.jvmArgs>
    <!-- The phase the fault runs are bound to; the profile one-test sets it to none. -->
    <vfdlibm.fault.phase>test</vfdlibm.fault.phase>
    <!-- The test JVM's options, shared by the normal run and every fault run. -->
    <vfdlibm.test.argLine>
      --add-modules ${vector.module} ${vfdlibm.test.jvmArgs}
    </vfdlibm.test.argLine>
  </properties>

  <!-- Google's mirror of Maven Central first, Central after it: Central has answered a shared CI
       runner with 403. The mirror lags (404 for what is new), and a 404, an error or a failed
       checksum on it goes on to Central. -->
  <repositories>
    <repository>
      <id>gcs-maven-central-mirror</id>
      <name>Google's mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <releases>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
