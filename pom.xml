  <build>
    <resources>
      <!-- The licence and the notice travel with the classes, in the jar's META-INF/ (and in the
           sources jar, which packs the same resources; the release profile puts them in the
           Javadoc jar). NOTICE carries Sun's fdlibm notice, which
           the ported sources keep in their headers and compiled classes do not.
           dev/jar-check.sh requires both. Naming any resource replaces Maven's default, so
           src/main/resources is named too: there is none today, and one added later is packed
           (and then has to be allowed by dev/jar-check.sh, which fails on a file it does not
           know). -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>${vector.module}</arg>
            <!-- No -Werror: javac's warning that an incubating module is in use cannot be
                 suppressed, and would fail every build. -->
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <!-- JMH's annotation processor writes the benchmark list and harness classes. JDK 23
               and later run no processor unless one is configured, so it is named here. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.openjdk.jmh</groupId>
                  <artifactId>jmh-generator-annprocess</artifactId>
                  <version>${jmh.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Benchmarks live in src/jmh/java and compile with the tests, so `verify` keeps them
             building; the jmh profile runs them. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>add-jmh-source</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>src/jmh/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.version}</version>
        <configuration>
          <argLine>${vfdlibm.test.argLine}</argLine>
          <excludes>
            <!-- JMH's generated *_jmhTest classes are benchmarks, not tests. -->
            <exclude>**/jmh_generated/**</exclude>
            <!-- Surefire's own default, which a list of excludes replaces. -->
            <exclude>**/*$*</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- The normal suite, with no fault planted. -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>fault</excludedGroups>
            </configuration>
          </execution>
          <!-- The fault runs (PLAN.md section 4): one forked JVM per planted fault, with
               -Dvfdlibm.fault=<name> set before Faults loads, running only the tests tagged
               `fault`, which require the fault's checks to fail. A fault is listed in
               PlantedFaultTest.CATCHERS and gets an execution here; PlantedFaultTest checks that
               both hold. A fault run that runs no test fails (failIfNoTests), so a mistyped
               group or a lost tag cannot drop the fault's check silently. With -Dtest=..., the
               profile one-test unbinds the fault runs, which that filter would leave empty. -->
          <execution>
            <id>fault-selftest.oneUlp</id>
            <phase>${vfdlibm.fault.phase}</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>fault</groups>
              <failIfNoTests>true</failIfNoTests>
              <argLine>${vfdlibm.test.argLine} -Dvfdlibm.fault=selftest.oneUlp</argLine>
            </configuration>
