(echo "bits >= 0: HX, the masked word, i and the new high word are the C's: expect unsat")
(push 1)
(declare-const b (_ BitVec 64))
(assert (bvsge b #x0000000000000000))
(assert (not (and (= (p.hx b) (widen (c.hx b))) (= (p.hxm b) (widen (c.hxm b)))
  (= (p.i b #x0000000000095f64) (widen (c.i b #x00095f64)))
  (= (p.newhi b) (widen (c.newhi b))))))
(check-sat)
(pop 1)

(echo "bits >= 0: kBits is the C's k plus DK_MAGIC_BITS: expect unsat")
(push 1)
(declare-const b (_ BitVec 64))
(assert (bvsge b #x0000000000000000))
(assert (not (= (p.kbits b #x0000000000000000) (bvadd (widen (c.k b #x00000000))
  #x4338000000000000))))
(check-sat)
(pop 1)

(echo "bits >= 0: kBits is the C's k, -54 first, plus DK_MAGIC_BITS: expect unsat")
(push 1)
(declare-const b (_ BitVec 64))
(assert (bvsge b #x0000000000000000))
(assert (not (= (p.kbits b #xffffffffffffffca) (bvadd (widen (c.k b #xffffffca))
  #x4338000000000000))))
(check-sat)
(pop 1)

(echo "bits >= 0: the |f| < 2^-20 test and the band test are the C's: expect unsat")
(push 1)
(declare-const b (_ BitVec 64))
(assert (bvsge b #x0000000000000000))
(assert (not (and (= (p.small b) (c.small b))
  (= (p.band b #x000000000006147a #x000000000006b851) (c.band b #x0006147a #x0006b851)))))
(check-sat)
(pop 1)

(echo "every long: kBits - DK_MAGIC_BITS is in [-1077, 3073]: expect unsat")
(push 1)
(declare-const b (_ BitVec 64))
(define-fun k () (_ BitVec 64) (bvsub (p.kbits b #x0000000000000000) #x4338000000000000))
(assert (not (and (bvsle #xfffffffffffffbcb k) (bvsle k #x0000000000000c01))))
(check-sat)
(pop 1)

(echo "every long: kBits - DK_MAGIC_BITS is in [-1077, 3073], with the -54: expect unsat")
