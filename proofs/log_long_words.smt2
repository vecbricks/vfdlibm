; The C, on the signed int hx = __HI(x), and the port, on the long bits.
(define-fun c.hx ((b Int)) Int (l2i (jlong.shr b 32)))
(define-fun c.hxm ((b Int)) Int (jint.and.low (c.hx b) 1048576))
(define-fun c.i ((b Int) (split Int)) Int
  (jint.and (jint.add (c.hxm b) split) 1048576))
(define-fun c.newhi ((b Int)) Int
  (jint.or (c.hxm b) (jint.xor (c.i b 614244) 1072693248)))
(define-fun c.k ((b Int) (k0 Int)) Int
  (jint.add (jint.add k0 (jint.sub (jint.shr (c.hx b) 20) 1023))
            (jint.shr (c.i b 614244) 20)))
(define-fun c.small ((b Int)) Bool (< (jint.and.low (jint.add 2 (c.hxm b)) 1048576) 3))
(define-fun c.band ((b Int) (lo Int) (hi Int)) Bool
  (> (jint.or (jint.sub (c.hxm b) lo) (jint.sub hi (c.hxm b))) 0))
(define-fun p.hx ((b Int)) Int (jlong.ushr b 32))
(define-fun p.hxm ((b Int)) Int (jlong.and.low (p.hx b) 1048576))
(define-fun p.i ((b Int) (split Int)) Int
  (jlong.and (jlong.add (p.hxm b) split) 1048576))
(define-fun p.newhi ((b Int)) Int
  (jlong.or (p.hxm b) (jlong.xor (p.i b 614244) 1072693248)))
(define-fun p.kbits ((b Int) (k0 Int)) Int
  (jlong.add (jlong.add (jlong.add (jlong.ushr (p.hx b) 20) 4843621399236967425) k0)
             (jlong.ushr (p.i b 614244) 20)))
(define-fun p.small ((b Int)) Bool (< (jlong.and.low (jlong.add (p.hxm b) 2) 1048576) 3))
(define-fun p.band ((b Int) (lo Int) (hi Int)) Bool
  (> (jlong.or (jlong.sub (p.hxm b) lo) (jlong.sub hi (p.hxm b))) 0))

(echo "bits >= 0: HX, the masked word, i and the new high word are the C's: expect unsat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (and (= (p.hx b) (i2l (c.hx b))) (= (p.hxm b) (i2l (c.hxm b)))
  (= (p.i b 614244) (i2l (c.i b 614244)))
  (= (p.newhi b) (i2l (c.newhi b))))))
(check-sat)
(pop 1)

(echo "bits >= 0: kBits is the C's k plus DK_MAGIC_BITS: expect unsat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (= (p.kbits b 0) (jlong.add (i2l (c.k b 0)) 4843621399236968448))))
(check-sat)
(pop 1)

(echo "bits >= 0: kBits is the C's k, -54 first, plus DK_MAGIC_BITS: expect unsat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (= (p.kbits b (- 54)) (jlong.add (i2l (c.k b (- 54))) 4843621399236968448))))
(check-sat)
(pop 1)

(echo "bits >= 0: the |f| < 2^-20 test and the band test are the C's: expect unsat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (and (= (p.small b) (c.small b))
  (= (p.band b 398458 440401) (c.band b 398458 440401)))))
(check-sat)
(pop 1)

(echo "every long: kBits - DK_MAGIC_BITS is in [-1077, 3073]: expect unsat")
(push 1)
(declare-const b Int)
(assert (jlong.in b))
(define-fun k () Int (- (p.kbits b 0) 4843621399236968448))
(assert (not (and (<= (- 1077) k) (<= k 3073))))
(check-sat)
(pop 1)

(echo "every long: kBits - DK_MAGIC_BITS is in [-1077, 3073], with the -54: expect unsat")
(push 1)
(declare-const b Int)
(assert (jlong.in b))
(define-fun k () Int (- (p.kbits b (- 54)) 4843621399236968448))
(assert (not (and (<= (- 1077) k) (<= k 3073))))
(check-sat)
(pop 1)

; The sign hypothesis is needed, and each word is tight.

(echo "refuted: for a negative bits HX is not the C's hx: expect sat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (< b 0)))
(assert (not (= (p.hx b) (i2l (c.hx b)))))
(check-sat)
(pop 1)

(echo "refuted: SQRT2_SPLIT + 1 = 0x95f65 changes i: expect sat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (= (p.i b 614245) (i2l (c.i b 614244)))))
(check-sat)
(pop 1)

(echo "refuted: HX_BAND_LO - 1 changes the band test: expect sat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (= (p.band b 398457 440401) (c.band b 398458 440401))))
(check-sat)
(pop 1)

(echo "refuted: HX_BAND_HI + 1 changes the band test: expect sat")
(push 1)
(declare-const b Int)
(assert (and (jlong.in b) (<= 0 b)))
(assert (not (= (p.band b 398458 440402) (c.band b 398458 440401))))
(check-sat)
(pop 1)
