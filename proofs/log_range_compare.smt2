; Log.inRange, and the C's tests on hx = __HI(x) signed and lx = __LO(x) unsigned.
(define-fun in.range ((b Int) (lo Int) (hi Int)) Bool
  (< (jlong.add b (jlong.sub (- 9223372036854775808) lo))
     (jlong.add (- 9223372036854775808) (jlong.sub hi lo))))
(define-fun c.hx ((b Int)) Int (l2i (jlong.shr b 32)))
(define-fun c.lx ((b Int)) Int (jlong.and.low b 4294967296))

(echo "inRange(bits, lo, hi) is lo <= bits < hi, every long and lo <= hi: expect unsat")
(push 1)
(declare-const b Int) (declare-const lo Int) (declare-const hi Int)
(assert (and (jlong.in b) (jlong.in lo) (jlong.in hi) (<= lo hi)))
(assert (not (= (in.range b lo hi) (and (<= lo b) (< b hi)))))
(check-sat)
(pop 1)

(echo "the common range is the C's: not hx < 0x100000 and not hx >= 0x7ff00000: expect unsat")
(push 1)
(declare-const b Int)
(assert (jlong.in b))
(assert (not (= (in.range b 4503599627370496 9218868437227405312) (and (not (< (c.hx b) 1048576))
  (not (>= (c.hx b) 2146435072))))))
(check-sat)
(pop 1)

(echo "the subnormal range [1, COMMON_LO) is the C's three tests: expect unsat")
(push 1)
(declare-const b Int)
(assert (jlong.in b))
(assert (not (= (in.range b 1 4503599627370496) (and (< (c.hx b) 1048576) (not (= (jint.or
  (jint.and.low (c.hx b) 2147483648) (l2i (c.lx b))) 0)) (not (< (c.hx b) 0))))))
(check-sat)
(pop 1)

